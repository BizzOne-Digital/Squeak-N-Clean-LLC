# Copy to .env.local (or set in Vercel). All values are public (inlined into the site) — never put secrets here.
# Leave a value empty to hide it; nothing fake is shown.

# Production origin, e.g. https://www.example.com — used for canonical URLs, sitemap, robots, Open Graph, JSON-LD.
NEXT_PUBLIC_SITE_URL=

# Public https link to the third-party scheduler page (Calendly, Cal.com, Square, etc.). Embedded on /booking.
NEXT_PUBLIC_BOOKING_URL=

# Shown on /contact and in LocalBusiness JSON-LD only when set.
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=
# Defaults to "Texas" (confirmed in PRD) when empty.
NEXT_PUBLIC_SERVICE_AREA=
